# ─────────────────────────────────────────────────────────────────────────────
# DjoHealth Mobile — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT — physical device setup:
#   The default 127.0.0.1 only works on iOS/Android simulators on the same machine.
#   On a real phone, replace 127.0.0.1 with your computer's LAN IP address.
#
#   How to find your LAN IP:
#     Windows : Run `ipconfig` in cmd → look for "IPv4 Address" (e.g. 192.168.1.42)
#     macOS   : Run `ipconfig getifaddr en0` in Terminal
#     Linux   : Run `hostname -I` in Terminal
#
#   Example for a real device: EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
#   Both phone and computer must be on the same Wi-Fi network.
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
