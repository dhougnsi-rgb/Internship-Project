# Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost/hospital_db

# JWT secret — change this to a long random string before deploying
SECRET_KEY=change-this-to-a-long-random-secret-key-before-deploying

# Optional: URL of the external AI translation service (Français ↔ Ghomala)
# Leave empty to use the development placeholder
TRANSLATION_API_URL=

# Google Gemini API key — get one free at https://aistudio.google.com
# Used for French ↔ Ghomala translation and AI pre-diagnostics
GEMINI_API_KEY=your-gemini-api-key-here

# Schema bootstrap mode:
#   true  (default) = create_all at startup, good for local dev
#   false           = requires 'alembic upgrade head' to be run first (production)
AUTO_CREATE_TABLES=true
